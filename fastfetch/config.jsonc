{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  // ========================
  // LOGO
  // ========================
  "logo": {
    "type": "auto",
    "source": "~/.config/fastfetch/ascii/logo.txt",
    "color": {
      "1": "magenta",
      "2": "green"
    }
  },

  // ========================
  // GENERAL STYLE
  // ========================
  "display": {
    "separator": "  ➜  "
  },

  // ========================
  // MODULES
  // ========================
  "modules": [
    "title",
    "separator",
    "os",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "break",
    "colors",
    "break",
    "break"
  ]
}
